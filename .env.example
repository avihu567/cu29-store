# Copy to .env.local and fill in. Add the same values in Vercel → Settings → Environment Variables.

# Meta Pixel (public)
NEXT_PUBLIC_META_PIXEL_ID=29040538945575201

# PayPal (public client ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional, server-only: verify payments with PayPal before marking orders paid
PAYPAL_CLIENT_SECRET=

# HYP credit-card payments (server-only)
HYP_MASOF=
HYP_API_KEY=
HYP_PASS_P=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://iaunbxxrdrfyhqiqadkq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_PUBLISHABLE_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SECRET_KEY_HERE

# /admin dashboard password (server-only) — choose a strong one, never commit the real value
ADMIN_PASSWORD=choose-a-strong-password

# Resend — order confirmation emails (server-only)
RESEND_API_KEY=PASTE_YOUR_RESEND_KEY_HERE
ADMIN_EMAIL=PASTE_YOUR_EMAIL_HERE
# Optional, once the domain is verified in Resend (otherwise CU29 <onboarding@resend.dev> is used)
RESEND_FROM_EMAIL=
